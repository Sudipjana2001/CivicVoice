# Supabase client configuration for local development
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional legacy fallback used by the client if the publishable key
# is not set. Keep only one of the key variables populated.
# VITE_SUPABASE_ANON_KEY=

# Used only by the Supabase Edge Function for the India post assistant.
# Do not prefix these with VITE_ or expose them to the browser bundle.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
